{
  "default": {
    "paths": [
      "src/features/**/*.feature"
    ],
    "require": [
      "src/steps/**/*.ts",
      "src/supports/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "progress",
      "summary",
      "json:reports/cucumber_report.json",
      "html:reports/cucumber_report.html",
      "junit:reports/junit.xml"
    ],
    "dryRun": false,
      "tags": "@add",
      "timeout":30000
  }
}